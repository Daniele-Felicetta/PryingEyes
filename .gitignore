/My project/
unity_logs/

# Unity generati (progetto unity/ tracciato senza cartelle di build)
unity/PryingEyes/Library/
unity/PryingEyes/Temp/
unity/PryingEyes/Logs/
unity/PryingEyes/UserSettings/
unity/PryingEyes/Builds/
unity/PryingEyes/Data/
# Scene derivate: le rigenerano CityBuilder e CityRoomBuilder (tracciate cambiavano a ogni prova e finivano nei commit)
unity/PryingEyes/Assets/_PryingEyes/Scenes/Citta.unity
unity/PryingEyes/Assets/_PryingEyes/Scenes/Citta.unity.meta
unity/PryingEyes/Assets/_PryingEyes/Scenes/Labs/
unity/PryingEyes/Assets/_PryingEyes/Scenes/Labs.meta
*.csproj
*.slnx
.vsconfig
# Blender: file intermedi della pipeline, li rigenera modelli/monaco/genera_monaco.py (fasi geo ed export)
modelli/monaco/monaco_geo.blend
modelli/monaco/export/monaco_export.blend
__pycache__/
# Blender fase 4 (occhio, abate, arredi, mani): intermedi e copie degli FBX; quella che conta e' in unity/.../Models, si rigenerano con gli script
modelli/abate/abate_animato.blend
modelli/abate/stoffa_tris.npz
modelli/abate/export/
modelli/occhio/occhio.blend
modelli/occhio/export/
modelli/hotel/arredi/*.fbx
modelli/hotel/mani/*.fbx
modelli/hotel/mani2/*.fbx
# Piani procedurali: il progetto del laboratorio dotnet resta tracciato nonostante *.csproj, non le sue cartelle di build;
# degli FBX di Blender si tengono solo quelli in unity/.../Models (si rigenerano con gli script), le anteprime in render/ come per gli altri modelli
!tools/planlab/PlanLab.csproj
!tools/weaponslab/WeaponsLab.csproj
tools/planlab/bin/
tools/planlab/obj/
tools/weaponslab/bin/
tools/weaponslab/obj/
!tools/survivallab/SurvivalLab.csproj
tools/survivallab/bin/
tools/survivallab/obj/
!tools/economylab/EconomyLab.csproj
tools/economylab/bin/
tools/economylab/obj/
!tools/saveslab/SavesLab.csproj
!tools/desertlab/DesertLab.csproj
tools/desertlab/bin/
tools/desertlab/obj/
tools/saveslab/bin/
tools/saveslab/obj/
modelli/chiesa/export/*.fbx
modelli/hotel/arredi2/*.fbx
modelli/hotel/arredi3/*.fbx
modelli/hotel/arredi4/*.fbx
modelli/hotel/arredi5/*.fbx
# Armi (fase 5): i FBX e le texture che contano stanno in unity/.../Models/Armi; qui solo gli script. Si rigenerano con modelli/armi/genera_armi.py
modelli/armi/tex/
modelli/armi/export/
modelli/armi/render/
# Medusa volante: intermedi, FBX di esportazione e anteprime; la FBX che conta e le texture stanno in unity/.../Models/Medusa e Textures/Medusa. Si rigenerano con modelli/medusa/genera_medusa.py e genera_medusa_tex.py
modelli/medusa/medusa.blend
modelli/medusa/holes.json
modelli/medusa/export/
modelli/medusa/render/
# foto di verifica delle armi: si tengono solo i fogli di contatto (jpg) e la foto degli espositori; le singole foto si rifanno con ArmiShots / -guntest
hotel_build/armi/*.png
hotel_build/armi_gioco/*.png
!hotel_build/armi_gioco/espositori.png
# foto della sonda dei fotogrammi (1920x1080, 2-3 MB l'una, un'ottantina a ogni giro): si rifanno con -perftest -perfshots; si tiene solo il foglio di confronto
hotel_build/perf/
# prova delle magie e dei sigilli (-magiatest -magiashots): risultati e circa 190 foto a ogni giro, si rifanno
hotel_build/magia/
# prova della cattedrale e delle catacombe (-cattedraletest -cattedraleshots): foto a ogni giro, si rifanno
hotel_build/cattedrale/
# prova del deserto (-desertotest -desertshots): foto a ogni giro, si rifanno
hotel_build/deserto/
hotel_build/seats/

# Isolated multiplayer checks; never use the main worktree build output.
!tools/multiplayer-check/MultiplayerCheck.csproj
!tools/multiplayer-check/unity-compile/UnityModules.csproj
tools/multiplayer-check/unity-compile/bin/
tools/multiplayer-check/unity-compile/obj/
tools/multiplayer-check/bin/
tools/multiplayer-check/obj/
tools/multiplayer-check/.dotnet/
tools/multiplayer-check/.dependencies/
tools/unity-validation/
.unity-cache/
!tools/multiplayer-check/fishnet-compile/**/*.csproj
tools/multiplayer-check/fishnet-compile/**/bin/
tools/multiplayer-check/fishnet-compile/**/obj/

