(fn SpawnOne ()
  (Variables|Default|SetSpawnQueue (- (Variables|Default|GetSpawnQueue) 1))
  (Variables|Default|SetSpawnTimer 1.5)
  (bind idx (Math|Random|RandomIntegerinRange :Min 0 :Max 2))
  (bind sx (select (== idx 1) -3300.0 (select (== idx 2) 3000.0 0.0)))
  (bind sy (select (== idx 1) 0.0 (select (== idx 2) 0.0 -1800.0)))
  (bind isFly (== (Math|Random|RandomIntegerinRange :Min 0 :Max 1) 0))
  (bind tr (Math|Transform|MakeTransform :Location (Math|Vector|MakeVector :X sx :Y sy :Z 120.0)))
  (bind spawned (Game|SpawnActorfromClass :Class "/Game/Hotel/Gameplay/BP_Enemy.BP_Enemy_C" :SpawnTransform tr :CollisionHandlingOverride "AlwaysSpawn"))
  (bind e (Utilities|Casting|CastToBP_Enemy :Object spawned)
    (:then
      (Class|BPEnemy|SetHP :self e :HP (+ 60.0 (* 20.0 (Variables|Default|GetWave))))
      (Class|BPEnemy|SetMaxHP :self e :MaxHP (Class|BPEnemy|GetHP :self e))
      (Class|BPEnemy|SetSpeed :self e :Speed (select isFly 380.0 240.0))
      (Class|BPEnemy|SetAttackDamage :self e :AttackDamage (Variables|Default|GetEnemyDamage))
      (Class|BPEnemy|SetScoreValue :self e :ScoreValue (select isFly 100 150))
      (Class|BPEnemy|SetFlying :self e :bFlying isFly)
      (Rendering|SetVisibility :self (Class|BPEnemy|GetRotorL :self e) :bNewVisibility isFly :bPropagateToChildren false)
      (Rendering|SetVisibility :self (Class|BPEnemy|GetRotorR :self e) :bNewVisibility isFly :bPropagateToChildren false)
      (Rendering|SetVisibility :self (Class|BPEnemy|GetSensor :self e) :bNewVisibility isFly :bPropagateToChildren false)
      (Rendering|SetVisibility :self (Class|BPEnemy|GetPlateL :self e) :bNewVisibility (not isFly) :bPropagateToChildren false)
      (Rendering|SetVisibility :self (Class|BPEnemy|GetPlateR :self e) :bNewVisibility (not isFly) :bPropagateToChildren false)
      (Rendering|SetVisibility :self (Class|BPEnemy|GetEyeL :self e) :bNewVisibility (not isFly) :bPropagateToChildren false)
      (Rendering|SetVisibility :self (Class|BPEnemy|GetEyeR :self e) :bNewVisibility (not isFly) :bPropagateToChildren false)
      (Transformation|SetActorScale3D :self e :NewScale3D (Math|Vector|MakeVector :X (select isFly 0.9 1.7) :Y (select isFly 0.9 1.5) :Z (select isFly 0.9 1.5))))))
