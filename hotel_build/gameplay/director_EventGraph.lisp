(event EventBeginPlay
  (Input|EnableInput :self self :PlayerController (Game|GetPlayerController :PlayerIndex 0))
  (Variables|Default|SetWave 0)
  (Variables|Default|SetGameScore 0)
  (Variables|Default|SetKills 0)
  (Variables|Default|SetPlayerHP 100.0)
  (Variables|Default|SetMagSize 30)
  (Variables|Default|SetAmmo 30)
  (Variables|Default|SetReserve 120)
  (Variables|Default|SetEnemyDamage 8.0)
  (Variables|Default|SetSpawnQueue 0)
  (Variables|Default|SetSpawnTimer 0.0)
  (Variables|Default|SetFireTimer 0.0)
  (Variables|Default|SetRespawnTimer 2.0)
  (Variables|Default|SetGameOver false)
  (bind hud (UserInterface|CreateWidget :Class "/Game/Hotel/UI/WBP_HotelHUD.WBP_HotelHUD_C" :OwningPlayer (Game|GetPlayerController :PlayerIndex 0)))
  (UserInterface|Viewport|AddtoViewport :self hud :ZOrder 10)
  (CallFunction|StartWave))

(event EventTick (DeltaSeconds)
  (bind alive (Utilities|Array|Length (Actor|GetAllActorsOfClass :ActorClass "/Game/Hotel/Gameplay/BP_Enemy.BP_Enemy_C")))
  (bind pctrl (Game|GetPlayerController :PlayerIndex 0))
  (Variables|Default|SetFireTimer (- (Variables|Default|GetFireTimer) DeltaSeconds))
  (Variables|Default|SetSpawnTimer (- (Variables|Default|GetSpawnTimer) DeltaSeconds))
  (Variables|Default|SetRespawnTimer (- (Variables|Default|GetRespawnTimer) DeltaSeconds))
  (if (Game|Player|IsInputKeyDown :self pctrl :Key "LeftMouseButton")
    (CallFunction|TryFire))
  (if (Variables|Default|GetTestAutoFire)
    (if (<= (Variables|Default|GetAmmo) 0)
      (CallFunction|Reload))
    (CallFunction|TryFire))
  (if (Game|Player|WasInputKeyJustPressed :self pctrl :Key "R")
    (CallFunction|Reload))
  (if (and (> (Variables|Default|GetSpawnQueue) 0) (<= (Variables|Default|GetSpawnTimer) 0.0))
    (CallFunction|SpawnOne)
    (else
      (if (and (== (Variables|Default|GetSpawnQueue) 0) (and (== alive 0) (not (Variables|Default|GetGameOver))))
        (CallFunction|StartWave)))))

(event Game|Damage|EventAnyDamage (Damage DamageType InstigatedBy DamageCauser)
  (if (<= (Variables|Default|GetRespawnTimer) 0.0)
    (Variables|Default|SetPlayerHP (- (Variables|Default|GetPlayerHP) Damage))
    (if (<= (Variables|Default|GetPlayerHP) 0.0)
      (bind pc (Game|GetPlayerCharacter :PlayerIndex 0))
      (bind psArr (Actor|GetAllActorsOfClass :ActorClass "/Script/Engine.PlayerStart"))
      (bind ps (Utilities|Array|Get(acopy) psArr 0))
      (Transformation|SetActorLocation :self pc :NewLocation (Transformation|GetActorLocation :self ps))
      (Variables|Default|SetPlayerHP 100.0)
      (Variables|Default|SetAmmo (Variables|Default|GetMagSize))
      (Variables|Default|SetReserve 120)
      (Variables|Default|SetRespawnTimer 2.0)
      (Development|PrintString :InString "SEI MORTO - RESPAWN" :Duration 3.0))))
