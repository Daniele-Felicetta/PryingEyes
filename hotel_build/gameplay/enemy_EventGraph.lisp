(event EventBeginPlay
  (bind arr (Actor|GetAllActorsOfClass :ActorClass "/Game/Hotel/Gameplay/BP_GameDirector.BP_GameDirector_C"))
  (if (> (Utilities|Array|Length arr) 0)
    (Variables|Default|SetManager (Utilities|Array|Get(acopy) arr 0)))
  (Rendering|SetVisibility :self (Variables|Default|GetRotorL) :bNewVisibility false :bPropagateToChildren false)
  (Rendering|SetVisibility :self (Variables|Default|GetRotorR) :bNewVisibility false :bPropagateToChildren false)
  (Rendering|SetVisibility :self (Variables|Default|GetSensor) :bNewVisibility false :bPropagateToChildren false))

(event Game|Damage|EventAnyDamage (Damage DamageType InstigatedBy DamageCauser)
  (CallFunction|TakeHit :Damage Damage))

(event EventTick (DeltaSeconds)
  (bind pc (Game|GetPlayerCharacter :PlayerIndex 0))
  (Utilities|IsValid pc
    (:"Is Valid"
      (bind myLoc (Transformation|GetActorLocation :self self))
      (bind plLoc (Transformation|GetActorLocation :self pc))
      (bind dist (Math|Vector|Distance(Vector) :V1 myLoc :V2 plLoc))
      (bind d (Utilities|Operators|Subtract :A plLoc :B myLoc))
      (bind flat (Math|Vector|MakeVector :X (.x d) :Y (.y d) :Z (select (Variables|Default|GetFlying) (.z d) 0.0)))
      (bind dir (Math|Vector|Normalize :A flat))
      (bind slack (- dist 140.0))
      (bind want (* (Variables|Default|GetSpeed) DeltaSeconds))
      (bind len (select (> slack 0.0) (select (> want slack) slack want) 0.0))
      (bind sx (* (.x dir) len))
      (bind syy (* (.y dir) len))
      (bind sz (* (.z dir) len))
      (Transformation|AddActorWorldOffset :self self :DeltaLocation (Math|Vector|MakeVector :X sx :Y syy :Z sz) :bSweep false)
      (Variables|Default|SetAttackTimer (- (Variables|Default|GetAttackTimer) DeltaSeconds))
      (if (and (< dist 170.0) (<= (Variables|Default|GetAttackTimer) 0.0))
        (Variables|Default|SetAttackTimer 1.6)
        (Game|Damage|ApplyDamage :DamagedActor (Variables|Default|GetManager) :BaseDamage (Variables|Default|GetAttackDamage)))
      (if (Variables|Default|GetFlying)
        (Variables|Default|SetAge (+ (Variables|Default|GetAge) DeltaSeconds))
        (Transformation|AddLocalRotation :self (Variables|Default|GetRotorL) :DeltaRotation (Math|Rotator|MakeRotator :Roll 0.0 :Pitch 0.0 :Yaw 720.0))
        (Transformation|AddLocalRotation :self (Variables|Default|GetRotorR) :DeltaRotation (Math|Rotator|MakeRotator :Roll 0.0 :Pitch 0.0 :Yaw -720.0))
        (Transformation|AddActorWorldOffset :self self :DeltaLocation (Math|Vector|MakeVector :X 0.0 :Y 0.0 :Z (* (Math|Trig|Sin(Radians) :A (* (Variables|Default|GetAge) 3.0)) 60.0)) :bSweep false)
        (bind loc2 (Transformation|GetActorLocation :self self))
        (if (< (.z loc2) 80.0)
          (Transformation|SetActorLocation :self self :NewLocation (Math|Vector|MakeVector :X (.x loc2) :Y (.y loc2) :Z 80.0)))))
    (:"Is Not Valid")))
