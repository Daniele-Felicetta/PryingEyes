(fn TickGun (DeltaSeconds)
  (bind gun (Variables|Default|GetGun))
  (Utilities|IsValid gun
    (:"Is Valid"
      (bind bg (Utilities|Casting|CastToBP_Gun :Object gun)
        (:then
          (bind ppc2 (Game|GetPlayerCharacter :PlayerIndex 0))
          (bind cam (Game|GetPlayerCameraManager :PlayerIndex 0))
          (bind crot (Camera|GetCameraRotation :self cam))
          (bind cloc (Camera|GetCameraLocation :self cam))
          (bind fwd (Math|Vector|GetForwardVector :InRot crot))
          (bind rgt (Math|Vector|GetRightVector :InRot crot))
          (bind upv (Math|Vector|GetUpVector :InRot crot))
          (bind spd (Math|Vector|VectorLength (Transformation|GetVelocity :self ppc2)))
          (bind bamp (select (> spd 600.0) 1.0 (Utilities|Operators|Divide :A spd :B 600.0)))
          (bind nbp (+ (Variables|Default|GetBobPhase) (* DeltaSeconds (+ 4.0 (* 6.0 bamp)))))
          (Variables|Default|SetBobPhase nbp)
          (bind bs (Math|Trig|Sin(Radians) :A nbp))
          (bind bz (* (Math|Trig|Cos(Radians) :A nbp) (* 1.5 bamp)))
          (bind bx (* bs (* 2.5 bamp)))
          (bind o1 (+ (.x cloc) (* (.x fwd) 45.0)))
          (bind o2 (+ o1 (* (.x rgt) 16.0)))
          (bind o3 (+ o2 (* (.x upv) -10.0)))
          (bind ox (+ o3 bx))
          (bind q1 (+ (.y cloc) (* (.y fwd) 45.0)))
          (bind q2 (+ q1 (* (.y rgt) 16.0)))
          (bind q3 (+ q2 (* (.y upv) -10.0)))
          (bind oy (+ q3 bx))
          (bind z1 (+ (.z cloc) (* (.z fwd) 45.0)))
          (bind z2 (+ z1 (* (.z rgt) 16.0)))
          (bind z3 (+ z2 (* (.z upv) -10.0)))
          (bind oz (+ z3 bz))
          (bind kick (Variables|Default|GetKickPitch))
          (bind grot (Math|Rotator|MakeRotator :Roll 0.0 :Pitch (+ (.pitch crot) kick) :Yaw (.yaw crot)))
          (bind gpos (Math|Vector|MakeVector :X ox :Y oy :Z oz))
          (Transformation|SetActorLocationAndRotation :self gun :NewLocation gpos :NewRotation grot :bSweep false :bTeleport true)
          (Variables|Default|SetKickPitch (select (> kick 0.0) (- kick (* 12.0 DeltaSeconds)) 0.0))
          (Variables|Default|SetFlashTimer (- (Variables|Default|GetFlashTimer) DeltaSeconds))
          (Rendering|SetVisibility :self (Class|BPGun|GetFlash :self bg) :bNewVisibility (> (Variables|Default|GetFlashTimer) 0.0) :bPropagateToChildren false))))
    (:"Is Not Valid")))
