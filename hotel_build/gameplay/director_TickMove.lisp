(fn TickMove (DeltaSeconds)
  (bind pctrl (Game|GetPlayerController :PlayerIndex 0))
  (bind ppc (Game|GetPlayerCharacter :PlayerIndex 0))
  (bind sprinting (or (Game|Player|IsInputKeyDown :self pctrl :Key "LeftShift") (Variables|Default|GetTestAutoWalk)))
  (bind mov (Class|Character|GetCharacterMovement :self ppc))
  (Class|CharacterMovementComponent|SetMaxWalkSpeed :self mov :MaxWalkSpeed (select sprinting 900.0 600.0))
  (bind qdown (Game|Player|IsInputKeyDown :self pctrl :Key "Q"))
  (bind edown (Game|Player|IsInputKeyDown :self pctrl :Key "E"))
  (bind leanTgt (+ (select qdown -12.0 0.0) (select edown 12.0 0.0)))
  (bind leanStep (select (> (* 10.0 DeltaSeconds) 1.0) 1.0 (* 10.0 DeltaSeconds)))
  (bind leanNew (+ (Variables|Default|GetLeanRoll) (* (- leanTgt (Variables|Default|GetLeanRoll)) leanStep)))
  (Variables|Default|SetLeanRoll leanNew)
  (if (Variables|Default|GetTestAutoWalk)
    (bind tcrot (Pawn|GetControlRotation :self (Game|GetPlayerController :PlayerIndex 0)))
    (bind tdir (Math|Vector|GetForwardVector :InRot tcrot))
    (Pawn|Input|AddMovementInput :self ppc :WorldDirection tdir :ScaleValue 1.0 :bForce false))
  (if (Game|Player|WasInputKeyJustPressed :self pctrl :Key "C")
    (if (and sprinting (<= (Variables|Default|GetSlideTimer) 0.0))
      (bind sfwd (Transformation|GetActorForwardVector :self ppc))
      (bind svx (* (.x sfwd) 1300.0))
      (bind svy (* (.y sfwd) 1300.0))
      (bind sv (Math|Vector|MakeVector :X svx :Y svy :Z 150.0))
      (Character|LaunchCharacter :self ppc :LaunchVelocity sv :bXYOverride true :bZOverride true)
      (Variables|Default|SetSlideTimer 1.2))
    (else
      (if (Variables|Default|GetCrouched)
        (Character|UnCrouch :self ppc)
        (Variables|Default|SetCrouched false))
      (else
        (Character|Crouch :self ppc)
        (Variables|Default|SetCrouched true))))
  (if (> (Variables|Default|GetTestYawRate) 0.0)
    (bind tpctrl (Game|GetPlayerController :PlayerIndex 0))
    (bind trot (Pawn|GetControlRotation :self tpctrl))
    (bind nyaw (+ (.yaw trot) (* (Variables|Default|GetTestYawRate) DeltaSeconds)))
    (Pawn|SetControlRotation :self tpctrl :NewRotation (Math|Rotator|MakeRotator :Roll 0.0 :Pitch (.pitch trot) :Yaw nyaw)))
  (bind trot2 (Pawn|GetControlRotation :self pctrl))
  (bind fyaw (.yaw trot2))
  (bind fpitch (.pitch trot2))
  (Pawn|SetControlRotation :self pctrl :NewRotation (Math|Rotator|MakeRotator :Roll (Variables|Default|GetLeanRoll) :Pitch fpitch :Yaw fyaw)))
