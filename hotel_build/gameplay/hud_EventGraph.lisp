(event UserInterface|EventTick (MyGeometry InDeltaTime)
  (bind arr (Actor|GetAllActorsOfClass :ActorClass "/Game/Hotel/Gameplay/BP_GameDirector.BP_GameDirector_C"))
  (if (> (Utilities|Array|Length arr) 0)
    (bind d (Utilities|Casting|CastToBP_GameDirector :Object (Utilities|Array|Get(acopy) arr 0))
      (:then
        (bind hpv (Class|BPGameDirector|GetPlayerHP :self d))
        (bind hpt (Utilities|Text|ToText(Float) :Value hpv :MinimumFractionalDigits 0 :MaximumFractionalDigits 0))
        (Widget|SetText(Text) :self (Variables|WBP_HotelHUD|GetTxtHP) :InText hpt)
        (bind hv2 (Class|BPGameDirector|GetShield :self d))
        (bind sht (Utilities|Text|ToText(Float) :Value hv2 :MinimumFractionalDigits 0 :MaximumFractionalDigits 0))
        (Widget|SetText(Text) :self (Variables|WBP_HotelHUD|GetTxtShield) :InText sht)
        (bind amv (Class|BPGameDirector|GetAmmo :self d))
        (bind amt (Utilities|Text|ToText(Integer) :Value amv))
        (Widget|SetText(Text) :self (Variables|WBP_HotelHUD|GetTxtAmmo) :InText amt)
        (bind rev (Class|BPGameDirector|GetReserve :self d))
        (bind ret (Utilities|Text|ToText(Integer) :Value rev))
        (Widget|SetText(Text) :self (Variables|WBP_HotelHUD|GetTxtReserve) :InText ret)
        (bind scv (Class|BPGameDirector|GetGameScore :self d))
        (bind svt (Utilities|Text|ToText(Integer) :Value scv))
        (Widget|SetText(Text) :self (Variables|WBP_HotelHUD|GetTxtScore) :InText svt)
        (bind wav (Class|BPGameDirector|GetWave :self d))
        (bind wvt (Utilities|Text|ToText(Integer) :Value wav))
        (Widget|SetText(Text) :self (Variables|WBP_HotelHUD|GetTxtWave) :InText wvt)
        (bind htv (Class|BPGameDirector|GetHitTimer :self d))
        (bind htt (select (> htv 0.0) "X" ""))
        (Widget|SetText(Text) :self (Variables|WBP_HotelHUD|GetTxtHit) :InText htt)
        (bind kls (Class|BPGameDirector|GetKills :self d))
        (bind klt (Utilities|Text|ToText(Integer) :Value kls))
        (Widget|SetText(Text) :self (Variables|WBP_HotelHUD|GetTxtFPS) :InText klt))))
