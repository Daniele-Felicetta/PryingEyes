{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "materials": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]+$"
          },
          "color": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          },
          "metallic": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "smoothness": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "emission": {
            "type": "number",
            "minimum": 0,
            "maximum": 10
          }
        },
        "required": [
          "id",
          "color",
          "metallic",
          "smoothness",
          "emission"
        ]
      }
    },
    "rooms": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]+$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "width": {
            "type": "number",
            "minimum": 20,
            "maximum": 100
          },
          "depth": {
            "type": "number",
            "minimum": 12,
            "maximum": 100
          },
          "doors": {
            "type": "array",
            "minItems": 2,
            "maxItems": 4,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "side": {
                  "enum": [
                    "front",
                    "back",
                    "left",
                    "right"
                  ]
                },
                "center": {
                  "type": "number",
                  "minimum": -50,
                  "maximum": 50
                },
                "width": {
                  "type": "number",
                  "minimum": 2.4,
                  "maximum": 20
                },
                "height": {
                  "type": "number",
                  "minimum": 2.6,
                  "maximum": 6
                }
              },
              "required": [
                "side",
                "center",
                "width",
                "height"
              ]
            }
          },
          "parts": {
            "type": "array",
            "minItems": 1,
            "maxItems": 500,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_.-]+$"
                },
                "kind": {
                  "enum": [
                    "box",
                    "cylinder",
                    "label",
                    "light",
                    "stairs"
                  ]
                },
                "material": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]+$"
                },
                "text": {
                  "type": "string",
                  "maxLength": 120
                },
                "position": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "x": {
                      "type": "number",
                      "minimum": -200,
                      "maximum": 200
                    },
                    "y": {
                      "type": "number",
                      "minimum": -200,
                      "maximum": 200
                    },
                    "z": {
                      "type": "number",
                      "minimum": -200,
                      "maximum": 200
                    }
                  },
                  "required": [
                    "x",
                    "y",
                    "z"
                  ]
                },
                "size": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "x": {
                      "type": "number",
                      "minimum": 0.001,
                      "maximum": 100
                    },
                    "y": {
                      "type": "number",
                      "minimum": 0.001,
                      "maximum": 100
                    },
                    "z": {
                      "type": "number",
                      "minimum": 0.001,
                      "maximum": 100
                    }
                  },
                  "required": [
                    "x",
                    "y",
                    "z"
                  ]
                },
                "yaw": {
                  "type": "number",
                  "minimum": -360,
                  "maximum": 360
                },
                "collider": {
                  "type": "boolean"
                },
                "intensity": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 100
                },
                "range": {
                  "type": "number",
                  "minimum": 0.1,
                  "maximum": 100
                },
                "steps": {
                  "description": "Number of risers of a stairs part (size.y is the total rise, size.z the run, yaw the climbing direction).",
                  "type": "integer",
                  "minimum": 2,
                  "maximum": 64
                }
              },
              "required": [
                "id",
                "kind",
                "material",
                "position",
                "size",
                "yaw",
                "collider"
              ],
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "kind": {
                        "const": "light"
                      }
                    }
                  },
                  "then": {
                    "required": [
                      "intensity",
                      "range"
                    ]
                  }
                },
                {
                  "if": {
                    "properties": {
                      "kind": {
                        "const": "label"
                      }
                    }
                  },
                  "then": {
                    "required": [
                      "text"
                    ]
                  }
                },
                {
                  "if": {
                    "properties": {
                      "kind": {
                        "const": "stairs"
                      }
                    }
                  },
                  "then": {
                    "required": [
                      "steps"
                    ],
                    "properties": {
                      "collider": {
                        "const": true
                      }
                    }
                  },
                  "else": {
                    "not": {
                      "required": [
                        "steps"
                      ]
                    }
                  }
                }
              ]
            }
          },
          "route": {
            "type": "array",
            "minItems": 2,
            "maxItems": 100,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "x": {
                  "type": "number",
                  "minimum": -200,
                  "maximum": 200
                },
                "y": {
                  "description": "Height of the surface to stand on; 0 (the default) is the room floor.",
                  "type": "number",
                  "minimum": 0,
                  "maximum": 50
                },
                "z": {
                  "type": "number",
                  "minimum": -200,
                  "maximum": 200
                }
              },
              "required": [
                "x",
                "z"
              ]
            }
          },
          "views": {
            "description": "Named pictures of the room: where to stand (like a route point) and what to look at, in metres above the floor.",
            "type": "array",
            "maxItems": 8,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "name": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]+$"
                },
                "position": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "x": {
                      "type": "number",
                      "minimum": -200,
                      "maximum": 200
                    },
                    "y": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 50
                    },
                    "z": {
                      "type": "number",
                      "minimum": -200,
                      "maximum": 200
                    }
                  },
                  "required": [
                    "x",
                    "z"
                  ]
                },
                "target": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "x": {
                      "type": "number",
                      "minimum": -200,
                      "maximum": 200
                    },
                    "y": {
                      "type": "number",
                      "minimum": -10,
                      "maximum": 50
                    },
                    "z": {
                      "type": "number",
                      "minimum": -200,
                      "maximum": 200
                    }
                  },
                  "required": [
                    "x",
                    "y",
                    "z"
                  ]
                }
              },
              "required": [
                "name",
                "position",
                "target"
              ]
            }
          }
        },
        "required": [
          "id",
          "name",
          "width",
          "depth",
          "doors",
          "parts",
          "route"
        ]
      }
    }
  },
  "required": [
    "schemaVersion",
    "materials",
    "rooms"
  ]
}
