{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Prying Eyes weapon production catalog",
  "type": "object",
  "required": [
    "schemaVersion",
    "weapons"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "weapons": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "index",
          "definition",
          "source"
        ],
        "additionalProperties": false,
        "properties": {
          "index": {
            "type": "integer",
            "minimum": 0
          },
          "definition": {
            "type": "object",
            "required": [
              "id",
              "name",
              "cls",
              "grade",
              "price",
              "cityOnly",
              "modes",
              "damage",
              "headMult",
              "rangeNear",
              "rangeFar",
              "farMult",
              "pellets",
              "cone",
              "pierce",
              "pierceMult",
              "rpm",
              "burst",
              "burstGap",
              "cycle",
              "mag",
              "reserve",
              "reserveMax",
              "reload",
              "reloadEmpty",
              "style",
              "shellTime",
              "hip",
              "ads",
              "moveSpread",
              "bloomShot",
              "bloomMax",
              "bloomRecover",
              "recV",
              "recH",
              "recRecover",
              "kick",
              "adsTime",
              "drawTime",
              "moveMult",
              "adsMoveMult",
              "sight",
              "zoom",
              "adsFov",
              "adsDist",
              "pattern",
              "dotSize",
              "snd",
              "flash",
              "suppressed",
              "casing",
              "tracerEvery",
              "tracerColor",
              "tracerWidth",
              "tracerPellets",
              "beam",
              "fx",
              "soundEvery",
              "flashColor",
              "reticle",
              "hand",
              "handDrop",
              "magUp"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]+$"
              },
              "name": {
                "type": "string"
              },
              "cls": {
                "type": "string"
              },
              "grade": {
                "type": "integer",
                "minimum": 1,
                "maximum": 5
              },
              "price": {
                "type": "integer",
                "minimum": 0
              },
              "cityOnly": {
                "type": "boolean"
              },
              "modes": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "enum": [
                    "Auto",
                    "Semi",
                    "Burst",
                    "Pump",
                    "Bolt",
                    "Double",
                    "Lever"
                  ]
                }
              },
              "damage": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "headMult": {
                "type": "number"
              },
              "rangeNear": {
                "type": "number"
              },
              "rangeFar": {
                "type": "number"
              },
              "farMult": {
                "type": "number"
              },
              "pellets": {
                "type": "integer",
                "minimum": 1
              },
              "cone": {
                "type": "number"
              },
              "pierce": {
                "type": "integer",
                "minimum": 0
              },
              "pierceMult": {
                "type": "number"
              },
              "rpm": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "burst": {
                "type": "integer",
                "minimum": 1
              },
              "burstGap": {
                "type": "number"
              },
              "cycle": {
                "type": "number"
              },
              "mag": {
                "type": "integer",
                "minimum": 1
              },
              "reserve": {
                "type": "integer",
                "minimum": 0
              },
              "reserveMax": {
                "type": "integer",
                "minimum": 0
              },
              "reload": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "reloadEmpty": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "style": {
                "enum": [
                  "Mag",
                  "Pistol",
                  "Tube",
                  "Revolver",
                  "Break",
                  "Belt"
                ]
              },
              "shellTime": {
                "type": "number"
              },
              "hip": {
                "type": "number"
              },
              "ads": {
                "type": "number"
              },
              "moveSpread": {
                "type": "number"
              },
              "bloomShot": {
                "type": "number"
              },
              "bloomMax": {
                "type": "number"
              },
              "bloomRecover": {
                "type": "number"
              },
              "recV": {
                "type": "number"
              },
              "recH": {
                "type": "number"
              },
              "recRecover": {
                "type": "number"
              },
              "kick": {
                "type": "number"
              },
              "adsTime": {
                "type": "number"
              },
              "drawTime": {
                "type": "number"
              },
              "moveMult": {
                "type": "number"
              },
              "adsMoveMult": {
                "type": "number"
              },
              "sight": {
                "type": "string"
              },
              "zoom": {
                "type": "number"
              },
              "adsFov": {
                "type": "number"
              },
              "adsDist": {
                "type": "number"
              },
              "pattern": {
                "type": "integer",
                "minimum": 0
              },
              "dotSize": {
                "type": "number"
              },
              "snd": {
                "type": "string"
              },
              "flash": {
                "type": "number"
              },
              "suppressed": {
                "type": "boolean"
              },
              "casing": {
                "type": "string"
              },
              "tracerEvery": {
                "type": "number"
              },
              "tracerColor": {
                "type": "array",
                "minItems": 4,
                "maxItems": 4,
                "items": {
                  "type": "number",
                  "minimum": 0
                }
              },
              "tracerWidth": {
                "type": "number"
              },
              "tracerPellets": {
                "type": "integer",
                "minimum": 1
              },
              "beam": {
                "type": "boolean"
              },
              "fx": {
                "type": "string"
              },
              "soundEvery": {
                "type": "integer",
                "minimum": 1
              },
              "flashColor": {
                "type": "array",
                "minItems": 4,
                "maxItems": 4,
                "items": {
                  "type": "number",
                  "minimum": 0
                }
              },
              "reticle": {
                "anyOf": [
                  {
                    "type": "array",
                    "minItems": 4,
                    "maxItems": 4,
                    "items": {
                      "type": "number",
                      "minimum": 0
                    }
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "hand": {
                "type": "number"
              },
              "handDrop": {
                "type": "number"
              },
              "magUp": {
                "type": "boolean"
              }
            }
          },
          "source": {
            "type": "object",
            "required": [
              "generator",
              "recipe",
              "requiredSockets",
              "dependencies"
            ],
            "additionalProperties": false,
            "properties": {
              "generator": {
                "const": "modelli/armi/genera_armi.py"
              },
              "recipe": {
                "type": "object",
                "required": [
                  "file",
                  "entry"
                ],
                "additionalProperties": false,
                "properties": {
                  "file": {
                    "type": "string",
                    "pattern": "^modelli/armi/[a-z0-9_]+\\.py$"
                  },
                  "entry": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_]+$"
                  }
                }
              },
              "requiredSockets": {
                "type": "array",
                "minItems": 2,
                "uniqueItems": true,
                "items": {
                  "type": "string"
                }
              },
              "dependencies": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "family": {
                "enum": [
                  "municipal_pistol"
                ]
              },
              "parameters": {
                "type": "object",
                "required": [
                  "textureSize",
                  "boreHeight",
                  "barrelStart",
                  "barrelEnd",
                  "rearSerrations",
                  "frontSerrations",
                  "polymerColor"
                ],
                "additionalProperties": false,
                "properties": {
                  "textureSize": {
                    "enum": [
                      512,
                      1024,
                      2048
                    ]
                  },
                  "boreHeight": {
                    "type": "number",
                    "minimum": 0.065,
                    "maximum": 0.1
                  },
                  "barrelStart": {
                    "type": "number",
                    "minimum": -0.1,
                    "maximum": -0.02
                  },
                  "barrelEnd": {
                    "type": "number",
                    "minimum": 0.08,
                    "maximum": 0.22
                  },
                  "rearSerrations": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 15
                  },
                  "frontSerrations": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 15
                  },
                  "polymerColor": {
                    "type": "array",
                    "minItems": 3,
                    "maxItems": 3,
                    "items": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    }
                  }
                }
              }
            },
            "dependentRequired": {
              "family": [
                "parameters"
              ],
              "parameters": [
                "family"
              ]
            }
          }
        }
      }
    }
  }
}
