<Project>
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <UseSharedCompilation>false</UseSharedCompilation>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <FishNetRoot>$(MSBuildThisFileDirectory)../.dependencies/FishNet/Assets/FishNet/Runtime</FishNetRoot>
    <UnityManagedRoot Condition="'$(UnityManagedRoot)' == ''">C:/Program Files/Unity/Hub/Editor/6000.6.7f1/Editor/Data/Managed/UnityEngine</UnityManagedRoot>
    <UnityUiAssembly Condition="'$(UnityUiAssembly)' == ''">$(MSBuildThisFileDirectory)../.dependencies/UnityEngine.UI.dll</UnityUiAssembly>
    <DefineConstants>$(DefineConstants);UNITY_5_3_OR_NEWER;UNITY_2018_3_OR_NEWER;UNITY_2018_4_OR_NEWER;UNITY_2019_1_OR_NEWER;UNITY_2020_1_OR_NEWER;UNITY_2021_3_OR_NEWER;UNITY_2022_1_OR_NEWER;UNITY_2022_3_OR_NEWER;UNITY_6000_0_OR_NEWER;UNITY_6000_1_OR_NEWER;UNITY_6000_5_OR_NEWER;UNITY_STANDALONE_WIN</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="$(UnityManagedRoot)/UnityEngine*.dll"><Private>false</Private></Reference>
    <Reference Include="Newtonsoft.Json"><HintPath>$(UnityManagedRoot)/Newtonsoft.Json.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.UI"><HintPath>$(UnityUiAssembly)</HintPath><Private>false</Private></Reference>
    <Reference Include="FishNet.CodeAnalysis"><HintPath>$(FishNetRoot)/Plugins/CodeAnalysis/FishNet.CodeAnalysis.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
</Project>
